# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Comma-separated Telegram user IDs that have admin (master) access
ADMIN_IDS=111111111,222222222

# SQLAlchemy async database URL.
# Default: local SQLite file (good for quick start / small shops)
DATABASE_URL=sqlite+aiosqlite:///bot.db
# For production on a VPS, switch to PostgreSQL, e.g.:
# DATABASE_URL=postgresql+asyncpg://bot_user:bot_password@localhost:5432/barber_bot

# IANA timezone used for all schedule/booking calculations
TIMEZONE=Asia/Tashkent

# How many hours before the appointment to send a reminder to the client
REMINDER_HOURS_BEFORE=2
